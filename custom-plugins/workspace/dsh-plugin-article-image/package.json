{
  "name": "dsh-plugin-article-image",
  "version": "0.1.0",
  "description": "Article image planning: import Google Sheets, read articles and review editorial prompts",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "repository": { "type": "git", "url": "git+https://github.com/haigepor/dsh-AutoFlow.git", "directory": "custom-plugins/workspace/dsh-plugin-article-image" },
  "exports": { ".": "./index.js", "./execute": "./execute.js", "./skill": "./skill.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["index.js", "execute.js", "skill.js", "config-schema.js", "client.js", "cordis.patch.yml", "config.json", "src/**", "skills/**", "rules/**", "assets/**", "locale/*.json", "README.md", "README.zh.md", "release/**", "release.config.json"],
  "icon": "./assets/article-image-logo.webp",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "featureConfig": "./config.json",
      "update": { "provider": "github", "repository": "haigepor/dsh-AutoFlow", "tagPrefix": "article-image-v", "metadataAsset": "article-image-update.json" },
      "features": [
        { "id": "tools", "rowId": "article-image-tools", "kind": "script", "defaultEnabled": true, "title": { "en": "Article tools", "zh": "文章与提示词工具" }, "description": { "en": "Import links, read articles and save image plans. Approval is a workbench action.", "zh": "导入链接、读取文章、保存配图方案；审核在工作台完成。" } },
        { "id": "ui-panel", "rowId": "article-image-ui", "kind": "ui", "defaultEnabled": true, "title": { "en": "Workbench", "zh": "文章生图工作台" }, "description": { "en": "Manage articles and review prompts. Image generation is not connected.", "zh": "管理文章、编辑和审核提示词；生图接口尚未接入。" } },
        { "id": "skills", "rowId": "article-image-skills", "kind": "skill", "defaultEnabled": true, "title": { "en": "Editorial skills", "zh": "编辑配图 Skill" }, "description": { "en": "Article understanding and realistic editorial image planning.", "zh": "文章理解与写实编辑配图规划。" } }
      ],
      "examples": [{ "id": "status", "prompt": { "en": "Use article_image_status to check article image planning. Do not import or generate images.", "zh": "请用 article_image_status 查看文章生图配置和任务，不导入或生成图片。" } }]
    },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-locale"] }
  },
  "scripts": { "test": "vitest run --config vitest.config.mjs", "build:client": "node scripts/build-client.mjs", "check": "node scripts/check.mjs", "release:prepare": "node scripts/prepare-release.mjs", "prepack": "npm run build:client && npm run check" },
  "dependencies": { "article-image-toolkit": "workspace:*", "@mozilla/readability": "0.6.0", "jsdom": "29.1.1", "papaparse": "5.5.3", "zod": "^4.4.3" },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~", "@deepseek-ai/dsh-atomic-write": "workspace:*", "@deepseek-ai/dsh-web-fetch-http": "workspace:*", "@deepseek-ai/dsh-llm": "workspace:*" },
  "devDependencies": { "@deepseek-ai/cordis": "workspace:~", "@deepseek-ai/dsh-atomic-write": "workspace:*", "@deepseek-ai/dsh-web-fetch-http": "workspace:*", "@deepseek-ai/dsh-llm": "workspace:*", "esbuild": "0.28.1", "vitest": "^4.1.8" }
}
