{
  "openapi": "3.1.0",
  "info": {
    "title": "OperateImage adapter",
    "version": "1.0.0",
    "description": "Observed pull fields and multipart upload request from the supplied local test API. No receipt-query or lease operation is assumed."
  },
  "servers": [
    {
      "url": "http://lhapi.lockscreen.com",
      "description": "Explicit local test API; configure the production origin separately."
    }
  ],
  "paths": {
    "/OperateImage/pull.html": {
      "get": {
        "summary": "Get pending original images",
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending-image page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "total",
                    "page",
                    "pageSize",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pageSize": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "img_url"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]{0,31}$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "img_url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "md5": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "size": {
                            "type": [
                              "string",
                              "number",
                              "null"
                            ]
                          },
                          "update_time": {
                            "type": [
                              "string",
                              "number",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/OperateImage/receive.html": {
      "post": {
        "summary": "Receive an approved clean PNG associated with its source server ID",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "ids[0]",
                  "images[0]"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "ids[0]": {
                    "type": "string"
                  },
                  "images[0]": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "description": "The server accepts 1–20 matching index pairs. The adapter sends one file per request."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Observed single-file receipt; counters and the matching updated result are required for acceptance. Unrecognized receipts remain unknown.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "total",
                        "updated",
                        "failed",
                        "skipped",
                        "results"
                      ],
                      "properties": {
                        "total": {
                          "const": 1
                        },
                        "updated": {
                          "const": 1
                        },
                        "failed": {
                          "const": 0
                        },
                        "skipped": {
                          "const": 0
                        },
                        "results": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 1,
                          "items": {
                            "type": "object",
                            "required": [
                              "index",
                              "id",
                              "status"
                            ],
                            "properties": {
                              "index": {
                                "const": 0
                              },
                              "id": {
                                "oneOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[1-9][0-9]{0,31}$"
                                  },
                                  {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991
                                  }
                                ]
                              },
                              "status": {
                                "const": "updated"
                              },
                              "message": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "处理完成",
                  "data": {
                    "total": 1,
                    "updated": 1,
                    "failed": 0,
                    "skipped": 0,
                    "results": [
                      {
                        "index": 0,
                        "id": 69674,
                        "status": "updated",
                        "message": "更新成功"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Observed validation failure for a missing image batch",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "每批须提交 1～20 张图片，使用 ids[n] 和 images[n]。",
                  "data": []
                }
              }
            }
          }
        }
      }
    }
  }
}
