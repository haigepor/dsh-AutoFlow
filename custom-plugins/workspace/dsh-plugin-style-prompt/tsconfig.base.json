{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true, "jsx": "react-jsx"
  }
}
