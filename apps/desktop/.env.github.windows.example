# 无签名 Windows 测试通道；复制为 .env.windows，勿覆盖已有签名凭据。
DSH_DESKTOP_APP_ID=com.autoflow.desktop.unsigned
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DSH_DESKTOP_UPDATE_PROVIDER=github
DSH_DESKTOP_GITHUB_REPOSITORY=haigepor/dsh-AutoFlow
DSH_DESKTOP_GITHUB_PAGES_URL=https://haigepor.github.io/dsh-AutoFlow/desktop/unsigned/
DSH_DESKTOP_UNSIGNED_UPDATES=1
DSH_DESKTOP_MANDATORY_UPDATE_SOURCE=static-json
DSH_DESKTOP_MANDATORY_UPDATE_URL=https://haigepor.github.io/dsh-AutoFlow/desktop/unsigned/policy.json
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedPageOrigins":["https://github.com"]}'
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# 大型 npm 包下载超时时可使用已有镜像设置，仍保留锁文件完整性校验。
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# 可选：Microsoft x64 CRT DLL 所在目录；默认从 Visual Studio Redist 查找完整版本。
# DSH_DESKTOP_WINDOWS_CRT_DIR=C:/path/to/Microsoft.VC143.CRT
