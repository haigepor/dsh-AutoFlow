# Copy to .env.macos for certificate-free test packaging only.
# This mode applies ad-hoc code signatures, skips Apple notarization and disables updates.
# Use a separate Bundle ID from signed applications.
DSH_DESKTOP_APP_ID=com.autoflow.harness.macos.test.unsigned
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=2
# Optional verified registry/proxy settings; no credentials or update URLs are required.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/
# DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
